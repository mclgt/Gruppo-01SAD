<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="440.0" spacing="20.0" stylesheets="@../../style/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.Controller.playlist.AutoPlaylistController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>

      <Label text="Genera Playlist Automatica" styleClass="label-heading"/>

      <GridPane hgap="12.0" vgap="14.0">
         <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" prefWidth="110.0" />
            <ColumnConstraints hgrow="ALWAYS" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints prefHeight="35.0" />
            <RowConstraints prefHeight="35.0" />
            <RowConstraints prefHeight="35.0" />
            <RowConstraints prefHeight="35.0" />
         </rowConstraints>
         <children>
            <Label text="Nome Playlist:" GridPane.halignment="RIGHT"/>
            <TextField fx:id="txtName" promptText="Es. Rock anni '90"
                       GridPane.columnIndex="1" />

            <Label text="Anno:" GridPane.rowIndex="1" GridPane.halignment="RIGHT"/>
            <ComboBox fx:id="comboAnno" prefWidth="220.0"
                      GridPane.columnIndex="1" GridPane.rowIndex="1" />

           <Label text="Genere:" GridPane.rowIndex="2" GridPane.halignment="RIGHT"/>
            <ComboBox fx:id="comboGenre" prefWidth="220.0"
                      GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Tag:" GridPane.rowIndex="3" GridPane.halignment="RIGHT"/>
            <ComboBox fx:id="comboTag" prefWidth="220.0"
                      GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>

      <Label fx:id="lblNoTracks"
             text="Nessuna traccia trovata con i criteri selezionati." visible="false" managed="false" />

      <HBox alignment="CENTER_RIGHT" spacing="15.0">
         <VBox.margin><Insets top="5.0" /></VBox.margin>
         <children>
            <Button fx:id="btnCancel" cancelButton="true" mnemonicParsing="false"
                    onAction="#handleCancel" text="Annulla" />
            <Button fx:id="btnGenerate" defaultButton="true" mnemonicParsing="false" onAction="#handleGenerate" styleClass="btn-primary" text="Genera" />
         </children>
      </HBox>

   </children>
</VBox>
