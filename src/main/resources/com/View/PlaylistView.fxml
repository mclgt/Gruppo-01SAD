<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Controller.playlist.PlaylistController">
   <StackPane>
      <children>
         <Button fx:id="btnBack" mnemonicParsing="false" onAction="#handleBackToLibrary" text="Indietro" StackPane.alignment="CENTER_LEFT">
            <StackPane.margin>
               <Insets left="10.0" top="5.0" />
            </StackPane.margin></Button>
          <Label fx:id="lblPlaylist" alignment="CENTER" contentDisplay="CENTER" text="Nome della Playlist" StackPane.alignment="CENTER">
              <font>
                  <Font name="System Bold" size="20.0" />
              </font>
            <StackPane.margin>
               <Insets top="5.0" />
            </StackPane.margin>
          </Label>
         <Button fx:id="btnAddToPlaylist" mnemonicParsing="false" onAction="#handleAddToPlaylist" text="Aggiungi brano" StackPane.alignment="CENTER_RIGHT">
            <StackPane.margin>
               <Insets right="10.0" top="5.0" />
            </StackPane.margin>
         </Button>
      </children>
   </StackPane>
    
    <TableView fx:id="playlistTrackList" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitle" prefWidth="250.0" text="Titolo" />
            <TableColumn fx:id="colAuthor" prefWidth="200.0" text="Autore" />
            <TableColumn fx:id="colDuration" prefWidth="100.0" text="Durata" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      <opaqueInsets>
         <Insets />
      </opaqueInsets>
      <VBox.margin>
         <Insets bottom="10.0" left="10.0" right="10.0" />
      </VBox.margin>
    </TableView>
</VBox>
